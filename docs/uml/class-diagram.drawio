<mxfile host="Electron">
  <diagram id="FXSpLcvGDW13emoW244j" name="Page-1">
    <mxGraphModel dx="1258" dy="976" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% ===========================================================\n%%  Class Diagram (v2) - Project Management System (PMS)\n%%  Relationship legend:\n%%    *--  composition (Project owns Task/Sprint; Task owns Comment)\n%%    o--  aggregation (Sprint groups Task; Task is independent -&gt; Backlog if no Sprint)\n%%    --&gt;  association (directed) with multiplicity + role name\n%%    ProjectMember / TaskAssignment / TaskLink = association classes\n%%       (N-N with attributes) -&gt; map to join tables in the ERD\n%%  Note: all UML labels in English to match the C# code 1:1.\n%%        Entity methods = own-state invariants; cross-entity orchestration\n%%        + side effects (ActivityLog, Notification) live in the Service layer.\n%% ===========================================================\nclassDiagram\nclass Employee {\n  +Guid Id\n  +string Name\n  +string Email\n  -string PasswordHash\n  +SystemRole SystemRole\n  +IsSystemAdmin() bool\n  +VerifyPassword(string) bool\n}\nclass Project {\n  +Guid Id\n  +string Name\n  +DateTime ExpectedCompletionDate\n  +Status Status\n  +bool IsDeleted\n  +Complete() void\n  +IsCompleted() bool\n  +AddMember(Employee, RoleInProject) ProjectMember\n  +GetRoleOf(Employee) RoleInProject\n  +SoftDelete() void\n}\nclass Sprint {\n  +Guid Id\n  +string Name\n  +string Goal\n  +DateTime StartDate\n  +DateTime EndDate\n  +IsActive() bool\n  +AddTask(Task) void\n  +RemoveTask(Task) void\n}\nclass Task {\n  +Guid Id\n  +string Name\n  +DateTime DueDate\n  +Status Status\n  +Priority Priority\n  +bool IsDeleted\n  +CanTransitionTo(Status) bool\n  +ChangeStatus(Status) void\n  +IsOverdue() bool\n  +SubtaskProgress() decimal\n  +AddSubtask(Task) void\n  +AddAssignee(Employee, RoleInTask) void\n  +LinkTo(Task, LinkType) void\n  +SoftDelete() void\n}\nclass Comment {\n  +Guid Id\n  +string Content\n  +DateTime CreatedAt\n}\nclass Notification {\n  +Guid Id\n  +string Type\n  +bool IsRead\n  +DateTime CreatedAt\n  +MarkAsRead() void\n}\nclass ActivityLog {\n  +Guid Id\n  +string EntityType\n  +Guid EntityId\n  +string Action\n  +DateTime Timestamp\n}\nclass Label {\n  +Guid Id\n  +string Name\n}\nclass ProjectMember {\n  +RoleInProject RoleInProject\n  +DateTime JoinedDate\n  +InvitationStatus InvitationStatus\n  +Accept() void\n  +Decline() void\n  +IsActive() bool\n}\nclass TaskAssignment {\n  +RoleInTask RoleInTask\n  +DateTime AssignedDate\n}\nclass Watcher {\n  +DateTime CreatedAt\n}\nclass TaskLink {\n  +LinkType LinkType\n  +IsBlocking() bool\n}\nclass Status {\n  &lt;&lt;enumeration&gt;&gt;\n  ToDo\n  InProgress\n  Review\n  Done\n}\nclass Priority {\n  &lt;&lt;enumeration&gt;&gt;\n  Highest\n  High\n  Medium\n  Low\n  Lowest\n}\nclass RoleInProject {\n  &lt;&lt;enumeration&gt;&gt;\n  ProjectManager\n  Member\n  Viewer\n}\nclass InvitationStatus {\n  &lt;&lt;enumeration&gt;&gt;\n  Pending\n  Accepted\n  Declined\n}\nclass RoleInTask {\n  &lt;&lt;enumeration&gt;&gt;\n  Owner\n  Contributor\n}\nclass LinkType {\n  &lt;&lt;enumeration&gt;&gt;\n  Blocks\n  IsBlockedBy\n  RelatesTo\n  Duplicates\n}\nProject \&quot;1\&quot; *-- \&quot;0..*\&quot; Task\nProject \&quot;1\&quot; *-- \&quot;0..*\&quot; Sprint\nTask \&quot;1\&quot; *-- \&quot;0..*\&quot; Comment\nSprint \&quot;0..1\&quot; o-- \&quot;0..*\&quot; Task\nTask \&quot;parent 0..1\&quot; --&gt; \&quot;subtasks 0..*\&quot; Task\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProjectMember\nProject \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ProjectMember\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TaskAssignment\nTask \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TaskAssignment\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Watcher\nTask \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Watcher\nTask \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TaskLink : source\nTask \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TaskLink : target\nTask \&quot;0..*\&quot; -- \&quot;0..*\&quot; Label\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Task : reporter\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Comment : author\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notification\nEmployee \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ActivityLog\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="178">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
