        <UserObject label="    ĐIỂM THIẾT KẾ QUAN TRỌNG — KHÔNG gọi&#xa;    ProjectAuthorizationService.AuthorizeAsync().&#xa;&#xa;    AuthorizeAsync() -&gt; GetRoleInProjectAsync(), mà truy vấn&#xa;    đó lọc InvitationStatus == Accepted. Người đang Pending&#xa;    CHƯA có role -&gt; sẽ nhận 404 khi cố chấp nhận lời mời&#xa;    của CHÍNH MÌNH.&#xa;&#xa;    Đây là loại quyền khác: quyền trên LỜI MỜI của mình,&#xa;    không phải quyền trên PROJECT. Kiểm bằng cách đối chiếu&#xa;    currentUserId với chủ sở hữu lời mời." plantUmlId="note_42" plantUmlBaseStyle="shape=note;size=10;fillColor=#FFE8B7;strokeColor=#181818;strokeWidth=0.5;fontColor=#000000;fontSize=13;align=left;spacingLeft=4;spacing=2;verticalAlign=middle;whiteSpace=wrap;html=1;" plantUmlBaseValue="    ĐIỂM THIẾT KẾ QUAN TRỌNG — KHÔNG gọi&#xa;    ProjectAuthorizationService.AuthorizeAsync().&#xa;&#xa;    AuthorizeAsync() -&gt; GetRoleInProjectAsync(), mà truy vấn&#xa;    đó lọc InvitationStatus == Accepted. Người đang Pending&#xa;    CHƯA có role -&gt; sẽ nhận 404 khi cố chấp nhận lời mời&#xa;    của CHÍNH MÌNH.&#xa;&#xa;    Đây là loại quyền khác: quyền trên LỜI MỜI của mình,&#xa;    không phải quyền trên PROJECT. Kiểm bằng cách đối chiếu&#xa;    currentUserId với chủ sở hữu lời mời." id="wZqLKXHaL9KrwosK17zr-72">
