        <UserObject label="    BẮT BUỘC Include(Members): Project.Invite()&#xa;    kiểm tra trùng trên collection trong bộ nhớ.&#xa;    Không nạp đủ -&gt; invariant bị bỏ qua, chỉ còn&#xa;    unique index (ProjectId, EmployeeId) chặn." plantUmlId="note_72" plantUmlBaseStyle="shape=note;size=10;fillColor=#FEFFDD;strokeColor=#181818;strokeWidth=0.5;fontColor=#000000;fontSize=13;align=left;spacingLeft=4;spacing=2;verticalAlign=middle;whiteSpace=wrap;html=1;" plantUmlBaseValue="    BẮT BUỘC Include(Members): Project.Invite()&#xa;    kiểm tra trùng trên collection trong bộ nhớ.&#xa;    Không nạp đủ -&gt; invariant bị bỏ qua, chỉ còn&#xa;    unique index (ProjectId, EmployeeId) chặn." id="7mJH9Ul7MOLqZYzr9CaZ-92">
