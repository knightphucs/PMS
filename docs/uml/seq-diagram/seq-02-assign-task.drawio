<mxfile host="Electron">
  <diagram id="OZQEFKKtEmmPG4DgIWtT" name="Page-1">
    <mxGraphModel dx="1184" dy="919" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Sequence Diagram - Gán nhân sự vào task (+ sinh Notification)\n%% Entity method (Task.AddAssignee) vs Service orchestration (ActivityLog + Notification).\n%% Assignment + Log + Notification commit trong CÙNG 1 transaction.\nsequenceDiagram\nautonumber\nactor PM as ProjectManager\nparticipant API as TasksController\nparticipant Service as TaskAssignmentService\nparticipant Repo as Repositories\nparticipant Task as Task (entity)\nparticipant Logger as ActivityLogService\nparticipant Notifier as NotificationService\nparticipant UoW as UnitOfWork\nparticipant DB as Database\nPM-&gt;&gt;API: POST /api/v1/tasks/{id}/assignees (employeeId, role)\nAPI-&gt;&gt;Service: AssignAsync(taskId, employeeId, role, userId)\nService-&gt;&gt;Repo: GetTaskById(taskId)\nRepo-&gt;&gt;DB: SELECT Task\nDB--&gt;&gt;Repo: Task\nRepo--&gt;&gt;Service: Task\nalt task not found\n  Service--&gt;&gt;API: NotFoundException\n  API--&gt;&gt;PM: 404 Not Found\nelse task exists\n  Service-&gt;&gt;Repo: IsProjectMember(projectId, employeeId)\n  Repo--&gt;&gt;Service: bool\n  alt caller not PM or target not member\n    Service--&gt;&gt;API: ForbiddenException\n    API--&gt;&gt;PM: 403 Forbidden\n  else valid\n    Service-&gt;&gt;Task: AddAssignee(employee, role)\n    Note over Task: entity kiem tra trung,&lt;br/&gt;tao TaskAssignment\n    Service-&gt;&gt;Logger: Write(Assigned, task, userId)\n    Service-&gt;&gt;Notifier: Notify(employee, TaskAssigned, task)\n    Service-&gt;&gt;UoW: SaveChangesAsync()\n    UoW-&gt;&gt;DB: INSERT TaskAssignment + ActivityLog + Notification&lt;br/&gt;(single transaction)\n    DB--&gt;&gt;UoW: ok\n    Service--&gt;&gt;API: AssignmentDto\n    API--&gt;&gt;PM: 200 OK\n  end\nend\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="60">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry height="1455" width="1020" as="geometry" />
          </mxCell>
        </UserObject>
