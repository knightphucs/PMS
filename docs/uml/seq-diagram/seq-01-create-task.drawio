  <diagram id="URiEAgL3THAqoTrPNOO2" name="Page-1">
    <mxGraphModel dx="2012" dy="1562" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% Sequence Diagram - Tạo task (luồng CRUD nền qua các layer)\n%% Controller -&gt; Service -&gt; Repository -&gt; DB, gói ghi trong 1 transaction (UnitOfWork).\nsequenceDiagram\nautonumber\nactor PM as ProjectManager\nparticipant API as TasksController\nparticipant Service as TaskService\nparticipant Repo as Repositories\nparticipant UoW as UnitOfWork\nparticipant Logger as ActivityLogService\nparticipant DB as Database\nPM-&gt;&gt;API: POST /api/v1/tasks (CreateTaskDto) + JWT\nAPI-&gt;&gt;Service: CreateAsync(dto, userId)\nService-&gt;&gt;Repo: GetProjectRole(projectId, userId)\nRepo-&gt;&gt;DB: SELECT ProjectMembers\nDB--&gt;&gt;Repo: RoleInProject\nRepo--&gt;&gt;Service: RoleInProject\nalt userId is not ProjectManager\n  Service--&gt;&gt;API: ForbiddenException\n  API--&gt;&gt;PM: 403 Forbidden\nelse is ProjectManager\n  Service-&gt;&gt;Service: validate + map dto to Task (Status=ToDo, ReporterId=userId)\n  Service-&gt;&gt;Repo: AddAsync(task)\n  Service-&gt;&gt;Logger: Write(Created, task, userId)\n  Service-&gt;&gt;UoW: SaveChangesAsync()\n  UoW-&gt;&gt;DB: INSERT Task + ActivityLog (single transaction)\n  DB--&gt;&gt;UoW: ok\n  Service--&gt;&gt;API: TaskDto\n  API--&gt;&gt;PM: 201 Created (TaskDto)\nend\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="46">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
