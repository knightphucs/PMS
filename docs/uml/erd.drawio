<mxfile host="Electron">
  <diagram id="RaGyG__QCIk8mXn1-uQ2" name="Page-1">
    <mxGraphModel dx="1548" dy="1202" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%% ===========================================================\n%%  ERD (v1) - Project Management System (PMS)\n%%  Mapping rules from the Class Diagram:\n%%    - 1 class            -&gt; 1 table\n%%    - enum               -&gt; int column (EF Core default; lookup table optional)\n%%    - association class  -&gt; join table: ProjectMember / TaskAssignment / TaskLink\n%%    - pure N-N           -&gt; join table: TaskLabels / Watchers (composite PK)\n%%    - self-reference     -&gt; Tasks.ParentTaskId FK -&gt; Tasks.Id\n%%    - composition        -&gt; FK NOT NULL (Tasks.ProjectId)\n%%    - aggregation        -&gt; FK NULLABLE (Tasks.SprintId -&gt; Backlog when null)\n%%    - computed props     -&gt; NOT stored (IsOverdue, SubtaskProgress)\n%%    - polymorphic ref    -&gt; no hard FK (ActivityLogs.EntityId, Notifications.RelatedEntityId)\n%%  PK strategy:\n%%    - association classes get surrogate Id PK + UNIQUE(the two FKs)\n%%    - pure join tables use composite PK (Watchers, TaskLabels)\n%% ===========================================================\nerDiagram\nEMPLOYEES ||--o{ TASKS : reports\nEMPLOYEES ||--o{ COMMENTS : writes\nEMPLOYEES ||--o{ NOTIFICATIONS : receives\nEMPLOYEES ||--o{ ACTIVITY_LOGS : performs\nEMPLOYEES ||--o{ PROJECT_MEMBERS : joins\nEMPLOYEES ||--o{ TASK_ASSIGNMENTS : assigned\nEMPLOYEES ||--o{ WATCHERS : watches\nPROJECTS ||--o{ SPRINTS : has\nPROJECTS ||--o{ TASKS : contains\nPROJECTS ||--o{ PROJECT_MEMBERS : has\nSPRINTS |o--o{ TASKS : groups\nTASKS ||--o{ COMMENTS : has\nTASKS |o--o{ TASKS : parentOf\nTASKS ||--o{ TASK_ASSIGNMENTS : has\nTASKS ||--o{ WATCHERS : watchedBy\nTASKS ||--o{ TASK_LINKS : source\nTASKS ||--o{ TASK_LINKS : target\nTASKS ||--o{ TASK_LABELS : tagged\nLABELS ||--o{ TASK_LABELS : tags\nEMPLOYEES {\n  uuid Id PK\n  string Name\n  string Email UK\n  string PasswordHash\n  int SystemRole\n}\nPROJECTS {\n  uuid Id PK\n  string Name\n  string Description\n  datetime ExpectedCompletionDate\n  int Status\n  bool IsDeleted\n  datetime DeletedAt\n}\nSPRINTS {\n  uuid Id PK\n  uuid ProjectId FK\n  string Name\n  string Goal\n  datetime StartDate\n  datetime EndDate\n}\nTASKS {\n  uuid Id PK\n  string Name\n  uuid ProjectId FK\n  uuid SprintId FK\n  uuid ParentTaskId FK\n  uuid ReporterId FK\n  datetime DueDate\n  int Status\n  int Priority\n  bool IsDeleted\n  datetime DeletedAt\n}\nCOMMENTS {\n  uuid Id PK\n  uuid TaskId FK\n  uuid EmployeeId FK\n  string Content\n  datetime CreatedAt\n}\nNOTIFICATIONS {\n  uuid Id PK\n  uuid EmployeeId FK\n  int Type\n  string Content\n  bool IsRead\n  datetime CreatedAt\n  uuid RelatedEntityId\n}\nACTIVITY_LOGS {\n  uuid Id PK\n  uuid EmployeeId FK\n  string EntityType\n  uuid EntityId\n  string Action\n  string Detail\n  datetime Timestamp\n}\nLABELS {\n  uuid Id PK\n  string Name\n}\nPROJECT_MEMBERS {\n  uuid Id PK\n  uuid ProjectId FK\n  uuid EmployeeId FK\n  int RoleInProject\n  datetime JoinedDate\n  int InvitationStatus\n}\nTASK_ASSIGNMENTS {\n  uuid Id PK\n  uuid TaskId FK\n  uuid EmployeeId FK\n  int RoleInTask\n  datetime AssignedDate\n}\nWATCHERS {\n  uuid TaskId PK, FK\n  uuid EmployeeId PK, FK\n  datetime CreatedAt\n}\nTASK_LINKS {\n  uuid Id PK\n  uuid SourceTaskId FK\n  uuid TargetTaskId FK\n  int LinkType\n}\nTASK_LABELS {\n  uuid TaskId PK, FK\n  uuid LabelId PK, FK\n}\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="314">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
