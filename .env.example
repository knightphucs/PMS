# Chép thành `.env` rồi điền. `.env` đã nằm trong .gitignore — đừng commit.
#
#     cp .env.example .env && docker compose up -d

# --- bắt buộc ---

# Mật khẩu sa của SQL Server. SQL Server từ chối khởi động nếu mật khẩu không đạt
# độ phức tạp (>= 8 ký tự, có hoa/thường/số/ký tự đặc biệt).
MSSQL_SA_PASSWORD=

# Khóa ký JWT, TỐI THIỂU 32 byte (HMAC-SHA256) — JwtOptions ValidateOnStart sẽ chặn
# nếu ngắn hơn. Sinh nhanh:  openssl rand -base64 48
JWT_SECRET=

# Origin của frontend, KHÔNG có dấu / ở cuối. Dùng cho cả CORS lẫn link trong email mời.
FRONTEND_BASE_URL=https://pms-six-gamma.vercel.app

# --- tuỳ chọn: bỏ trống thì hệ thống KHÔNG gửi email nào (NullEmailSender) ---
#
# ⚠️ Quên mật khẩu và mời-qua-email chỉ hoạt động khi có SMTP_HOST. Không có nó thì
# hai luồng đó vẫn trả về thành công nhưng không có thư nào tới — đúng thiết kế
# (ADR-041 cấm để lộ email nào tồn tại), nên sẽ KHÔNG có lỗi nào báo cho biết.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
