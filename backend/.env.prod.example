# Chép thành `backend/.env.prod` rồi điền. File .env.prod ĐÃ nằm trong .gitignore.
#
#     cp backend/.env.prod.example backend/.env.prod
#     ./backend/run-production.sh
#
# 🔴 VÌ SAO PHẢI CÓ FILE NÀY: user-secrets của .NET chỉ được nạp khi
# ASPNETCORE_ENVIRONMENT=Development. Chuyển sang Production là ConnectionStrings và
# Jwt:Secret trong `dotnet user-secrets` BIẾN MẤT, và app chết ngay lúc khởi động với
# "Thiếu ConnectionStrings:DefaultConnection". Đây là cái bẫy đầu tiên và chắc chắn gặp.

# --- bắt buộc ---

# Y HỆT giá trị đang có trong user-secrets. Xem lại bằng:
#     dotnet user-secrets list --project backend/src/PMS.API
ConnectionStrings__DefaultConnection=Server=localhost,1433;Database=PMS;User Id=sa;Password=<mật khẩu SQL của bạn>;TrustServerCertificate=True;MultipleActiveResultSets=True

# Cũng lấy từ user-secrets. Tối thiểu 32 byte.
Jwt__Secret=<jwt secret của bạn>

# Domain Vercel. Dùng cho link trong email mời — SAI Ở ĐÂY = gửi đi những lá thư có link
# hỏng, không thu hồi được. AppOptions ValidateOnStart sẽ chặn nếu bỏ trống hoặc không
# phải URL tuyệt đối.
App__FrontendBaseUrl=https://pms-six-gamma.vercel.app
Cors__AllowedOrigins__0=https://pms-six-gamma.vercel.app

# Production mặc định KHÔNG tự áp migration. Bật lên vì đây là bản deploy demo và không
# có bước CI/CD nào khác chạy `dotnet ef database update`.
# ⚠️ DbSeeder thì VẪN không chạy ở Production (dữ liệu demo, mật khẩu biết trước) —
# nghĩa là DB rỗng sẽ không có tài khoản seed nào. Dùng lại DB "PMS" sẵn có thì không sao.
Database__MigrateOnStartup=true

# --- SMTP: bỏ trống = KHÔNG gửi email nào (quên mật khẩu / mời qua email im lặng hỏng) ---
#
# Gmail: bật 2-Step Verification rồi tạo App Password 16 ký tự tại
#        https://myaccount.google.com/apppasswords  (dán KHÔNG có dấu cách)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=<địa chỉ gmail của bạn>
Smtp__Password=<app password 16 ký tự>
Smtp__FromAddress=<cùng địa chỉ gmail>
Smtp__FromName=PMS - Quan ly du an
