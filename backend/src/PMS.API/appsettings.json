{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/pms-.log", "rollingInterval": "Day" } }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "DefaultConnection": "" },
  "App": { "FrontendBaseUrl": "" },
  "Jwt": {
    "Issuer": "PMS.API",
    "Audience": "PMS.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Cors": { "AllowedOrigins": [] },
  "//Smtp": [
    "Host RỖNG = chưa cắm SMTP -> hệ thống dùng NullEmailSender (im lặng nuốt email).",
    "Bật gửi thật bằng biến môi trường, KHÔNG sửa file này:",
    "  Smtp__Host=smtp.gmail.com  Smtp__Port=587  Smtp__EnableSsl=true",
    "  Smtp__User=<địa chỉ gửi>   Smtp__Password=<app password>",
    "🔴 Smtp__Password không bao giờ được commit. Xem SmtpOptions.",
    "⚠️ Development/Testing luôn ép SerilogEmailSender bất kể Smtp__* — xem ADR-058."
  ],
  "Smtp": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "User": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "PMS",
    "TimeoutSeconds": 10
  },
  "FileStorage": {
    "Root": "App_Data/attachments",
    "MaxFileBytes": 20971520,
    "AllowedExtensions": [
      ".png", ".jpg", ".jpeg", ".gif", ".webp",
      ".pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx",
      ".txt", ".csv", ".zip"
    ],
    "AllowedContentTypes": [
      "image/png", "image/jpeg", "image/gif", "image/webp",
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
      "application/vnd.ms-excel",
      "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
      "application/vnd.ms-powerpoint",
      "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "text/plain", "text/csv",
      "application/zip", "application/x-zip-compressed"
    ]
  }
}
